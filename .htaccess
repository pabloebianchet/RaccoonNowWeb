Options -Indexes

# CSS/JS del sitio cambian seguido durante desarrollo activo — caché corta
# para que los visitantes vean los cambios sin necesitar un hard refresh.
<IfModule mod_expires.c>
  <FilesMatch "\.(css|js)$">
    ExpiresActive On
    ExpiresDefault "access plus 1 hour"
  </FilesMatch>
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>

# Redirects 301 — páginas del sitio anterior
Redirect 301 /contacto.html https://www.raccoonnow.com/
Redirect 301 /proceso.html https://www.raccoonnow.com/
Redirect 301 /form.html https://www.raccoonnow.com/

# Forzar HTTPS + www en un solo redirect 301 (evita cadenas dobles)
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.raccoonnow.com%{REQUEST_URI} [L,R=301]
